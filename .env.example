# Scripture & The Way — configuration
# Copy this file to .env and fill in your key. NEVER commit .env.

# Your LLM API key (required). OpenRouter (https://openrouter.ai/keys) gives
# one key for Claude, GPT, Gemini, Llama, and hundreds of other models.
LLM_API_KEY=your-key-here

# Model to write the daily reflection (any model id your endpoint serves)
LLM_MODEL=anthropic/claude-sonnet-5

# Any OpenAI-compatible endpoint. Defaults to OpenRouter. Examples:
#   https://openrouter.ai/api/v1          (default)
#   https://api.openai.com/v1
#   http://localhost:11434/v1             (Ollama, fully local)
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Your agent's name, used in the reflection prompt
AGENT_NAME=Aurelius

# Daily schedule (used by scripts/daily-blog.sh): local timezone and hour
BLOG_TZ=America/New_York
BLOG_HOUR=7

# Set to 1 to auto-commit + push each new post to your GitHub fork
BLOG_GIT_PUSH=0
